# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/yeam_dev"
# Production: append ?sslmode=require
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/yeam_prod?sslmode=require"

# NextAuth v5
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-output"

# Production URL (required on Vercel — set to the canonical public domain).
# This must match the domain users actually browse, not the *.vercel.app alias,
# or OAuth will redirect users off the custom domain mid-sign-in.
AUTH_URL="https://app.yeam.ai"
# Dev alias (also accepted):
# NEXTAUTH_URL="http://localhost:3000"

# GitHub sign-in was removed in favour of Google-only (see lib/auth.ts).
# AUTH_GITHUB_ID / AUTH_GITHUB_SECRET are no longer read by anything.

# Google OAuth — NextAuth v5 standard names (preferred)
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret
# Legacy aliases also accepted by the code:
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# OAuth callback URLs to register in provider consoles:
#   Google:  https://app.yeam.ai/api/auth/callback/google
# Keep the *.vercel.app callbacks registered too if you still sign in there:
#   https://yeamagentsystem.vercel.app/api/auth/callback/google

# Model key. Everything generated — appeal letters, corrected-claim
# transmittals, the workspace assistant — goes through Google Gemini.
# Unset: drafting returns a clear error rather than failing oddly.
GEMINI_API_KEY="AIza..."

# Bounded judgments. Claim code prediction goes through TypeSafe's System One
# API, which returns a key from a finite map of options rather than free text —
# the options are built from this practice's own settled claims, so a code it
# has never been paid for cannot come back.
# Unset: the verdict is absent and says so, and the written review falls back to
# describing only the computed signals. Nothing else degrades.
TYPESAFE_API_KEY="ts_..."

# Lets an ADMIN set the workspace plan by hand in Settings, to look at the paid
# product without paying for it. Always on under `next dev`. On a real
# deployment it is off unless you set this to 1 — set it, test, unset it.
# Writes the entitlement column only; Stripe is never told, and a real
# subscription event overwrites whatever was set.
PLAN_OVERRIDE="0"

NODE_ENV="development"

# Shared passcode for the /appeals external review portal (link-shared with
# outside reviewers). Any non-empty string; rotating it invalidates issued cookies.
APPEALS_ACCESS_CODE=change-me

# Who may create a NEW account, comma-separated. Full addresses, or "@domain.com"
# for a whole domain. FAIL-CLOSED: leave this unset and nobody can register by any
# route (existing accounts still sign in). Closes both /signup and Google
# auto-provisioning. See lib/signup-access.ts.
#
# This was originally a hard requirement, because nothing in the app was scoped
# by organization and any self-registered account could read every row. That is
# no longer true — every customer-data query now goes through orgProcedure and
# is scoped to the caller's workspace. The gate is a deliberate choice about who
# may sign up, not a containment measure.
#
# It is currently UNSET in Vercel production, so nobody can create an account
# there at all. Set it to open registration.
SIGNUP_ALLOWED_EMAILS="@yeam.ai,you@example.com"

# Shared secret for the public appeal demo on yeam.ai. The website's own API
# route forwards here server-to-server with this in an x-yeam-demo-secret
# header; the endpoint is not browser-callable and sets no CORS headers.
# Must match PUBLIC_DEMO_SECRET in the yeam_website project. Unset = 503.
PUBLIC_DEMO_SECRET=generate-with-openssl-rand-hex-24

# Billing. Absent, the app runs with every workspace on TRIAGE and the upgrade
# path says billing is not set up rather than throwing — see lib/stripe.ts.
# STRIPE_PRICE_PRACTICE is the recurring price id for the Practice plan; the
# amount itself lives in the Stripe dashboard, never in this repo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRACTICE=
