# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/yeam_dev"
# Production: append ?sslmode=require
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/yeam_prod?sslmode=require"

# NextAuth v5
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-output"

# Production URL (required on Vercel — set to the canonical public domain).
# This must match the domain users actually browse, not the *.vercel.app alias,
# or OAuth will redirect users off the custom domain mid-sign-in.
AUTH_URL="https://app.yeam.ai"
# Dev alias (also accepted):
# NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth — NextAuth v5 standard names (preferred)
AUTH_GITHUB_ID=your-github-app-client-id
AUTH_GITHUB_SECRET=your-github-app-client-secret
# Legacy aliases also accepted by the code:
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...

# Google OAuth — NextAuth v5 standard names (preferred)
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret
# Legacy aliases also accepted by the code:
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# OAuth callback URLs to register in provider consoles:
#   GitHub:  https://app.yeam.ai/api/auth/callback/github
#   Google:  https://app.yeam.ai/api/auth/callback/google
# Keep the *.vercel.app callbacks registered too if you still sign in there:
#   https://yeamagentsystem.vercel.app/api/auth/callback/github
#   https://yeamagentsystem.vercel.app/api/auth/callback/google

# AI keys
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="AIza..."

NODE_ENV="development"

# Shared passcode for the /appeals external review portal (link-shared with
# outside reviewers). Any non-empty string; rotating it invalidates issued cookies.
APPEALS_ACCESS_CODE=change-me

# Who may create a NEW account, comma-separated. Full addresses, or "@domain.com"
# for a whole domain. FAIL-CLOSED: leave this unset and nobody can register by any
# route (existing accounts still sign in). Closes both /signup and Google
# auto-provisioning. Required because no query in the app is scoped by
# organization yet — see lib/signup-access.ts.
SIGNUP_ALLOWED_EMAILS="@yeam.ai,you@example.com"
