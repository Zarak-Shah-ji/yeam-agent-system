// Yeam.ai — Prisma schema
//
// A billing company's own denials and A/R, uploaded as a file. Nothing here
// holds PHI: there is no column for a patient name, member ID or date of birth
// anywhere in the customer-data tables, so a parser bug cannot quietly persist
// one. See lib/imports/deidentify.ts for the veto every import profile applies.
//
// This schema used to carry two more generations of the product alongside this
// one: a synthetic single-tenant EHR (Patient, Provider, Appointment, Encounter,
// Diagnosis, Procedure, Claim, ClaimEvent, InsuranceCoverage, Payer) and a
// statewide Texas Medicaid dataset (MedicaidProvider, MedicaidClaimsAgg,
// MedicaidPatient, MedicaidEncounter, HcpcsCode). Neither was org-scoped, and
// nothing reads them any more. They are removed here; the tables are dropped in
// a follow-up migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

// Only BILLING is written now — the assistant is one agent over the workspace's
// own data. The other four are retired personas from the multi-agent EHR, kept
// because existing agent_logs rows still carry them and dropping a value out
// from under live rows fails.
enum AgentName {
  FRONT_DESK
  CLINICAL_DOC
  CLAIM_SCRUBBER
  BILLING
  ANALYTICS
}

enum AgentStatus {
  THINKING
  WORKING
  COMPLETE
  ESCALATED
  ERROR
}

enum UserRole {
  ADMIN
  PROVIDER
  FRONT_DESK
  BILLING
}

// Billing tiers. `PRACTICE` here is a PRICE POINT, not the `Practice` model
// further down — a one-clinic customer's plan. The two are unrelated and neither
// reads the other; renaming either to "fix" the collision would break a
// subscription or a signature block for no gain. See model Practice.
enum OrgPlan {
  TRIAGE
  PRACTICE
  GROUP
  NETWORK
}

enum DenialRowStatus {
  TO_WORK
  DRAFTED
  SENT
  PAID
  DEAD
}

// Which profile an upload was read with. A DENIALS batch accumulates work items;
// a CLAIMS batch is a point-in-time snapshot. See lib/imports/claims-profile.ts.
enum ImportKind {
  DENIALS
  CLAIMS
}

enum OrgClaimStatus {
  PAID
  PARTIAL
  DENIED
  PENDING
  REJECTED
  WRITTEN_OFF
  UNKNOWN
}

// How an appeal actually reached the payer. Portal first because that is the
// channel most payers prefer and the only one that hands back a case number on
// the spot; MAIL is last because it is the one that needs a certified receipt to
// prove anything. OTHER exists so a real submission is never lost to a missing
// enum value.
enum SubmissionChannel {
  PORTAL
  FAX
  MAIL
  CLEARINGHOUSE
  PHONE
  OTHER
}

// What the payer did with the appeal.
//
// Until this existed the product recorded that a letter went out and never
// what came back, so "does this argument actually get paid by this payer" was
// unanswerable — for the biller reading one row, and for us reading all of them.
//
// PENDING is the state every submission is born in and most will sit in for
// weeks; it is a real answer ("we are still waiting"), not a missing value, so
// it is the default rather than a null.
//
// PARTIAL is separate from PAID because in appeals it is the common win: the
// payer allows two of the three units, or pays the claim and upholds the
// bundling adjustment. Folding it into PAID would overstate the win rate of
// every argument, and folding it into DENIED would understate it.
//
// NO_RESPONSE is not DENIED. A payer that never answered inside its own
// turnaround is a different fact, with a different remedy (escalate, or file a
// complaint with the state) than one that answered no.
enum SubmissionOutcome {
  PENDING
  PAID
  PARTIAL
  DENIED
  NO_RESPONSE
  WITHDRAWN
}

// Who says so.
//
// Stamped for the same reason resolveDestination stamps DestinationSource and
// ImportBatch stamps statusDerived: an outcome a human asserted after reading
// the payer's letter and one this app inferred from a later A/R export are not
// the same quality of evidence, and the aggregate that will eventually be sold
// as "what wins" must be able to tell them apart.
//
// REMITTANCE means lib/denials/reconcile.ts matched the row to a claim that a
// newer snapshot shows paid after the appeal went out. That is strong evidence
// and it is not proof — the payer may have paid for an unrelated reason.
enum OutcomeSource {
  BILLER
  REMITTANCE
}

// What happened to a claim, for the history a biller reads before phoning a
// payer. IMPORTED is not written as a row — it is derived from the batch the
// claim arrived on, because writing one per claim would mean 1,200 rows per
// upload saying nothing that the batch does not already say.
// What happened to a denial row. The claims-side ClaimEventKind is the model for
// this; the two are deliberately separate enums because the two records go
// through different lifecycles and a shared enum would carry values that are
// impossible on one side.
// Who wrote a version of a letter. The history is one linear list of versions
// and both authors append to it, so the column is what tells "Yeam revised it"
// apart from "the biller rewrote the third paragraph".
enum DraftSource {
  MODEL
  BILLER
}

enum DenialEventKind {
  STATUS_CHANGED
  NOTE_ADDED
  FOLLOW_UP_SET
  REOPENED
}

enum ClaimEventKind {
  STATUS_CHANGED
  NOTE_ADDED
  FOLLOW_UP_SET
  CODE_CORRECTED
  REVIEWED
  SENT_TO_WORKLIST
}

// What somebody did with the product, as opposed to what happened to a claim.
//
// A closed enum and not a string, because the whole value of this table is that
// it can be counted. One free-text name and the counts become a grep.
//
// Deliberately tiny. This exists to answer one question — when a biller opens a
// claim, what do they actually do next — and a vocabulary that grows past the
// question it was added for is how a telemetry table turns into a second,
// worse copy of the record.
enum UsageEventName {
  // The claim detail dialog was opened. The denominator for everything else.
  CLAIM_OPENED
  // A collapsed part of it was expanded. `detail` says which.
  CLAIM_SECTION_OPENED
  // Somebody left for the drafter. `detail` says from where — the list row, or
  // the dialog. That pair is the actual measurement: if almost every claim goes
  // to the drafter, the dialog is a speed bump on the way there.
  CLAIM_TO_DRAFTER
}

// ─── NextAuth Tables ─────────────────────────────────────────────────────────

model User {
  id               String               @id @default(cuid())
  name             String?
  email            String               @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             UserRole             @default(FRONT_DESK)
  accounts         Account[]
  sessions         Session[]
  agentLogs        AgentLog[]
  conversations    AgentConversation[]
  // Nullable: the seeded demo accounts pre-date tenancy and have no org. Every
  // account created from here on gets one at signup. Queries that read customer
  // data must go through orgProcedure, which refuses a user without an org
  // rather than falling back to reading everything.
  orgId            String?
  org              Organization?        @relation(fields: [orgId], references: [id])
  // The app had no way to answer "who logged in and when" — JWT sessions mean
  // the sessions table is never written. Stamped in the signIn callback.
  lastLoginAt      DateTime?
  // Which clinic this person is looking at, or null for all of them.
  //
  // User-writable, and therefore never trusted: practiceProcedure re-checks on
  // every read that it still belongs to ctx.orgId, and falls back to combined
  // mode when it does not. A stale id after an archive must widen the view, not
  // throw — the alternative is a biller locked out of their own worklist by a
  // setting they cannot see.
  //
  // NOT in the session token. lib/auth.ts uses JWT sessions with no database
  // session table, so a practice in the token could not change without
  // re-issuing it. orgProcedure already does one memoized user lookup per
  // request; this rides along in that same select and costs nothing extra.
  activePracticeId String?
  activePractice   Practice?            @relation(fields: [activePracticeId], references: [id])
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  worklistPrefs    WorklistPreference[]

  @@index([orgId])
  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model AgentLog {
  id         String      @id @default(cuid())
  taskId     String
  agentName  AgentName
  status     AgentStatus
  intent     String
  message    String
  reasoning  String?
  confidence Float?
  data       Json?
  userId     String?
  sessionId  String?
  durationMs Int?
  user       User?       @relation(fields: [userId], references: [id])
  createdAt  DateTime    @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@map("agent_logs")
}

// ─── Denial Workspace ────────────────────────────────────────────────────────
//
// The paid product: a billing company's own denials, saved, with the filing
// deadline still ticking tomorrow. Separate from the Patient/Encounter/Claim
// tables above, which are a synthetic single-tenant demo and are NOT org-scoped.
// Nothing here may reference those.
//
// De-identification is a schema-level promise, not just copy: there is no column
// for a patient name, member ID or date of birth, so a parser bug cannot quietly
// persist one. See lib/imports/deidentify.ts for the veto every import profile
// applies, and the FieldId unions in lib/denials/parse-claims.ts and
// lib/imports/claims-profile.ts for the only fields that are ever read.

model Organization {
  id                 String               @id @default(cuid())
  name               String
  plan               OrgPlan              @default(TRIAGE)
  users              User[]
  batches            ImportBatch[]
  rows               DenialRow[]
  claims             OrgClaim[]
  drafts             DenialDraft[]
  workedEvents       DenialWorkedEvent[]
  connectionRequests ConnectionRequest[]
  submissions        DenialSubmission[]
  payerDestinations  PayerDestination[]
  claimWork          ClaimWork[]
  claimEvents        ClaimEvent[]
  denialEvents       DenialEvent[]
  worklistPrefs      WorklistPreference[]
  conversations      AgentConversation[]
  practices          Practice[]
  usageEvents        UsageEvent[]

  // ─ The practice, as it appears on a letter ─────────────────────────────────
  //
  // Every drafted document ends in a signature block the model can only render
  // as [PRACTICE NAME], because the workspace had nowhere to hold the practice's
  // own details. These are the billing entity's identifiers, NOT a patient's —
  // an NPI and a TIN belong to the provider — so they are safe to store here and
  // do not touch the de-identification promise above.
  //
  // All nullable: a workspace is usable before anyone fills this in, and a
  // half-filled profile still beats retyping an NPI on every appeal.
  //
  // SINCE PRACTICES: these twelve are now the FALLBACK. A billing company runs
  // several clinics and needs a signature block per clinic, which is what model
  // Practice below holds. They were copied rather than moved so that no letter
  // drafted before practices existed loses its signature block, and so a
  // workspace that never creates a practice keeps working unchanged. Read
  // through practiceIdentity() (lib/practices/identity.ts) — never directly.
  practiceName String?
  npi          String?
  tin          String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  contactName  String?
  contactPhone String?
  contactFax   String?
  contactEmail String?

  // ─ Subscription ────────────────────────────────────────────────────────────
  //
  // What Stripe knows about this workspace. `plan` above stays the only thing
  // the app reads to decide what is allowed — these four exist so a webhook can
  // find the workspace an event belongs to, and so Settings can link someone to
  // their own billing portal without another Stripe round-trip.
  //
  // Deliberately NOT a source of entitlement on its own: if Stripe says active
  // and `plan` says TRIAGE, the customer is on TRIAGE and the webhook that was
  // supposed to reconcile them has a bug worth finding.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  // When a cancellation already requested will take effect. Stripe's portal
  // cancels at the end of the paid period, so for weeks a workspace is both
  // PRACTICE and cancelled — and without this the Settings card could only say
  // "Practice", which read as though the cancel had not worked. A fact Stripe
  // asserts, like currentPeriodEnd, not something derived; null when nothing is
  // pending, including after the cancellation has actually happened.
  subscriptionCancelAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

// One clinic inside a billing company.
//
// The tenant boundary is still Organization, deliberately. A billing company is
// the customer: one subscription, one allowance, one user roster, one Stripe
// customer. Practices are a grouping INSIDE that — which means a forgotten
// practice filter shows someone their own company's other clinic, a UX bug,
// where a forgotten org filter would be a cross-customer leak. Those two
// failures are not comparable, and that asymmetry is the whole reason this is a
// child model rather than a multi-org membership table.
//
// NOT related to OrgPlan.PRACTICE, which is a billing tier. See the comment
// there.
//
// The twelve identity columns are the same twelve on Organization. They were
// copied, not moved: Organization stays a fallback for one release so nothing
// drafted before this loses its signature block. See practiceIdentity().
//
// Holds no patient identifier, like every other table here — an NPI and a TIN
// identify the provider, not a person. __tests__/no-phi-columns.test.ts asserts
// it.
model Practice {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // What the biller calls this clinic in the switcher. Distinct from
  // practiceName, which is the legal name that goes on a letter — "Riverside"
  // and "Riverside Family Medicine, PLLC" are both right in their own place.
  name String

  // ─ The practice, as it appears on a letter ─────────────────────────────────
  practiceName String?
  npi          String?
  tin          String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  contactName  String?
  contactPhone String?
  contactFax   String?
  contactEmail String?

  // Where an import with no practice chosen lands, and what a new workspace's
  // backfilled practice is. Not enforced unique in the database: two defaults
  // is a settings bug that picks the older one, where a partial unique index
  // would make the fix itself fail.
  isDefault Boolean @default(false)

  // Archived, never deleted. A clinic that leaves still has letters, outcomes
  // and a year of denial history hanging off it; deleting the row would cascade
  // them away. Archived practices drop out of the switcher and the import picker
  // and stay readable everywhere else.
  archivedAt DateTime?

  batches ImportBatch[]
  rows    DenialRow[]
  claims  OrgClaim[]
  users   User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, archivedAt])
  @@map("practices")
}

// One upload. Holds either denial rows or claim rows depending on `kind`, which
// is why this is no longer called DenialBatch: the import summary, the refused
// column list and the delete-this-batch path are identical for both profiles.
model ImportBatch {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Which clinic the file was for. Nullable: every batch uploaded before
  // practices existed has none, and a workspace that never creates a practice
  // never sets one. This is where practiceId is actually CHOSEN — the rows and
  // claims below copy it from here at import time.
  practiceId     String?
  practice       Practice?    @relation(fields: [practiceId], references: [id])
  kind           ImportKind   @default(DENIALS)
  // A sample-practice batch, seeded with the workspace so a new account has
  // something to look at. Dropped the moment a real file lands, because seeded
  // rows sitting in the totals next to a customer's own denials is worse than
  // an empty worklist.
  isSample       Boolean      @default(false)
  filename       String
  rowCount       Int
  // Columns refused at parse time, surfaced in the import summary so the
  // customer can see that the patient names never left their machine.
  droppedColumns String[]
  // True when the export had no status column and status was inferred from the
  // amounts. Surfaced so a derived denial rate is never passed off as a read one.
  statusDerived  Boolean      @default(false)
  uploadedById   String?
  rows           DenialRow[]
  claims         OrgClaim[]
  createdAt      DateTime     @default(now())

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, kind, createdAt(sort: Desc)])
  @@map("import_batches")
}

model DenialRow {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  batchId String
  batch   ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // Denormalised from the batch, on purpose. batchId implies the practice, but
  // the worklist query scans up to 50k rows and a join to reach the filter
  // would be paid on every one of them; one nullable FK written at import time
  // makes it a direct predicate instead. It also lets a mis-filed row be
  // reassigned without moving it between batches, which is the repair a biller
  // will actually ask for.
  practiceId String?
  practice   Practice? @relation(fields: [practiceId], references: [id])

  // Facts as they arrived. De-identified by construction.
  claimNumber String?
  payer       String?
  carc        String
  billed      Decimal   @db.Decimal(12, 2)
  // Remittance date where the export had one, service date as the fallback.
  denialDate  DateTime?
  cpt         String?
  icd10       String?
  reason      String?

  // Human-owned state. Everything else about a row — remedy, filing window,
  // days left, whether it is expired — is DERIVED on read by triageRow() and is
  // deliberately not stored. A persisted deadline is wrong the next morning, and
  // a persisted remedy goes stale the moment the CARC rules are corrected.
  status DenialRowStatus @default(TO_WORK)
  note   String?

  // When a human last did something to this row — marked it sent, recorded an
  // outcome, left a note. Deliberately NOT updatedAt: any batch write resets
  // that, which would report a row as freshly handled when nothing happened to
  // it. The priority score reads this as the "last touch" signal, so a write
  // here must correspond to real work. See lib/denials/score.ts.
  lastTouchedAt DateTime?

  // When a machine last changed this row — the import reconciler closing it out
  // against a remittance. Separate from lastTouchedAt on purpose: the reconciler
  // used to stamp that one, which told the priority score a human had just
  // handled the row and reset its staleness. Two clocks, because they answer two
  // different questions.
  reconciledAt DateTime?

  // A date the biller set themselves, usually when marking a row sent. Their
  // judgement about when to look again outranks anything derived, so an overdue
  // follow-up lifts the row in the queue.
  followUpAt DateTime?

  drafts      DenialDraft[]
  submissions DenialSubmission[]
  events      DenialEvent[]
  workedEvent DenialWorkedEvent?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([orgId, status])
  @@index([batchId])
  // Overdue follow-ups are read across the whole workspace, not per batch.
  @@index([orgId, followUpAt])
  // The worklist's own predicate once a practice is isolated. Created
  // CONCURRENTLY in its own migration — Prisma wraps a migration in a
  // transaction, and CREATE INDEX CONCURRENTLY cannot run inside one.
  @@index([orgId, practiceId, status])
  @@map("denial_rows")
}

model DenialDraft {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rowId String
  row   DenialRow    @relation(fields: [rowId], references: [id], onDelete: Cascade)

  // Which instrument the denial actually calls for — appeal letter, corrected
  // claim, reconsideration, reprocessing request. Chosen by artifactFor().
  artifact  String
  body      String
  summary   String?
  // Revisions append rather than overwrite, so a customer can go back to the
  // draft they preferred after asking for it shorter.
  version   Int         @default(1)
  // Defaulted, so every version written before biller editing existed reads as
  // what it was: the model's.
  source    DraftSource @default(MODEL)
  // When the note that fed this version was written — a timestamp, never the
  // note itself, which lives on DenialRow.note and is free text a human typed.
  // Stored rather than derived because the note changes and this version does
  // not: "drafted from your note of 12 Sep" has to stay true in October.
  noteAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([orgId, createdAt(sort: Desc)])
  @@index([rowId, version])
  @@map("denial_drafts")
}

model DenialWorkedEvent {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Unique: a denial is billable once, no matter how many times it is redrafted.
  // Enforced here rather than in application code so a retry cannot double-bill.
  rowId String       @unique
  row   DenialRow    @relation(fields: [rowId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@map("denial_worked_events")
}

// One attempt at getting a document to the payer.
//
// `status = SENT` on its own is an unverified self-report: it records that
// somebody clicked a button, not what was sent, where it went, or what came
// back. A biller whose appeal is refused as untimely has to produce a portal
// case number, a fax confirmation or a certified-mail receipt, and until this
// existed there was nowhere in the product to keep one.
//
// One row per attempt, never overwritten. A first-level appeal that comes back
// denied is followed by a second-level appeal to a different address, and both
// halves of that history matter — so this is a list, not a set of columns on
// DenialRow.
//
// Holds NO patient identifier and no letter body. The identifiers are merged
// into the document in the browser and never reach the server (see
// lib/appeals/merge.ts); the body already lives in DenialDraft, referenced here
// by id and version so the record says which draft actually went out.
//
// Nothing derived is stored, same as everywhere else: the filing deadline and
// the required-attachment list are recomputed on read. What is stored is only
// what a human asserted and no query could re-derive.
model DenialSubmission {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rowId String
  row   DenialRow    @relation(fields: [rowId], references: [id], onDelete: Cascade)

  // Which draft went out. Nullable because a biller may well have sent a letter
  // they wrote themselves, and refusing to record that would put the proof
  // outside the product again.
  draftId      String?
  draftVersion Int?

  channel     SubmissionChannel
  // Where it went, as a human-readable label: the portal name, the fax number,
  // the PO box. Free text rather than a foreign key because the destination is a
  // fact about this attempt and must not change retroactively when the payer
  // directory is corrected.
  destination String

  sentAt          DateTime
  // The portal case number, fax confirmation or certified-mail tracking number.
  // The proof of timely filing.
  confirmationRef String?
  notes           String?
  submittedById   String?

  // ── What came back ────────────────────────────────────────────────────────
  //
  // On the attempt, not on DenialRow, and that is the whole design. A denial
  // that loses a first-level appeal and wins a second-level one has to record
  // both, because the question worth answering is not "did this claim get paid"
  // — the row status already says that — but "which argument, to which payer,
  // at which level, is what got it paid". Columns on the row would keep only
  // the last answer and silently destroy the first.
  outcome   SubmissionOutcome @default(PENDING)
  // When the payer answered, as far as the biller can tell — the date on the
  // determination letter or the remit, not the date somebody typed it in.
  // Days-to-resolution is outcomeAt minus sentAt, computed on read like every
  // other interval in this schema, and is deliberately not a column.
  outcomeAt DateTime?

  // What the appeal actually recovered. Null while PENDING, and null is also a
  // legitimate answer on a win the biller could not put a number to yet — the
  // win rate must not depend on this being filled in.
  amountRecovered Decimal? @db.Decimal(12, 2)

  // The code the payer denied the APPEAL under, which is routinely not the code
  // it denied the claim under. A CO-197 denial appealed and returned as CO-16 is
  // the payer saying the argument was fine and the paperwork was not, and that
  // distinction is the difference between rewriting the letter and refiling it.
  outcomeCarc String?
  // What the determination said, in the biller's words. The same field as
  // DenialRow.note and for the same reason: the real reason is often nowhere in
  // any structured code.
  outcomeNote String?

  outcomeSource     OutcomeSource?
  outcomeById       String?
  // When it was recorded here, as against outcomeAt, when it happened. An
  // outcome typed in six weeks late is still true; the gap is a measure of the
  // workspace's follow-up discipline, not of the payer's.
  outcomeRecordedAt DateTime?

  createdAt DateTime @default(now())

  @@index([orgId, sentAt(sort: Desc)])
  @@index([rowId, sentAt(sort: Desc)])
  // Two reads: "which appeals are still owed an answer" (outcome = PENDING,
  // oldest first) and the whole outcome aggregate, which scans resolved rows
  // for one org and would otherwise walk every submission ever made.
  @@index([orgId, outcome, sentAt])
  @@map("denial_submissions")
}

// Where THIS workspace sends appeals for a given payer.
//
// lib/billing/payers.ts is a Texas panel and says so in its own header. A
// billing company in Ohio has correct addresses for its own payers and we do
// not; this is where they record them, and an entry here outranks the built-in
// directory every time. It is also the honest answer to a payer we cannot
// resolve at all — an empty field the biller can fill, rather than a confidently
// wrong PO box.
//
// payerKey is the normalized payer name (see lib/billing/submission.ts), so a
// row that arrives as "UnitedHealthcare" and one that arrives as "United
// Healthcare" find the same entry.
model PayerDestination {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  payerKey   String
  payerLabel String

  channel        SubmissionChannel
  portalUrl      String?
  faxNumber      String?
  mailingAddress String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, payerKey])
  @@index([orgId])
  @@map("payer_destinations")
}

// A claim line from an A/R export. The denominator the denial worklist lacks.
//
// Same discipline as DenialRow: facts as they arrived, nothing derived stored.
// Aging buckets, collection rate and denial rate are all computed on read from
// these columns plus today's date, because a bucket written to the database is
// wrong the next morning.
//
// No patient identifier column exists here, deliberately. A claims export almost
// always carries a patient name; lib/imports/deidentify.ts refuses it at parse
// time and this schema gives it nowhere to land if that ever fails.
model OrgClaim {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  batchId String
  batch   ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // Copied from the batch at import time, for the same reason DenialRow carries
  // one: the analytics queries read claims by the millions-of-cents and would
  // otherwise join to filter.
  practiceId String?
  practice   Practice? @relation(fields: [practiceId], references: [id])

  claimNumber String?
  payer       String?
  status      OrgClaimStatus @default(UNKNOWN)

  billed      Decimal  @db.Decimal(12, 2)
  allowed     Decimal? @db.Decimal(12, 2)
  paid        Decimal? @db.Decimal(12, 2)
  patientResp Decimal? @db.Decimal(12, 2)
  adjustment  Decimal? @db.Decimal(12, 2)

  serviceDate   DateTime?
  submittedDate DateTime?
  remitDate     DateTime?

  cpt   String?
  icd10 String?
  carc  String?

  createdAt DateTime @default(now())

  @@index([orgId, status])
  @@index([batchId])
  @@index([orgId, serviceDate])
  // Joins a denied claim back to the worklist row that is working it.
  @@index([orgId, claimNumber])
  // Created CONCURRENTLY in its own migration. See DenialRow.
  @@index([orgId, practiceId])
  @@map("org_claims")
}

// Human-owned state for a claim, kept off OrgClaim on purpose.
//
// OrgClaim is a snapshot row. Only the newest CLAIMS batch is read, and next
// month's A/R export supersedes this one — so a status change or a corrected
// code written onto an OrgClaim would be silently discarded on the customer's
// normal monthly cadence, and deleting a batch would cascade it away. Keying on
// claimNumber instead means the work survives every re-import.
//
// This is the same split DenialRow already makes between "facts as they arrived"
// and human state; it is just forced here, because the facts are replaceable.
//
// Nothing here overwrites what was imported. A corrected code sits ALONGSIDE the
// one on the claim, because "billed 99213, should have been 99214" is the thing
// a coder actually needs to see — and the thing a corrected claim is built from.
model ClaimWork {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // The join key. Deliberately not a relation to OrgClaim: that row is replaced
  // every import and this one must outlive it.
  claimNumber String

  // What the biller says, when it differs from the export. Displayed next to the
  // imported status, never in place of it.
  statusOverride OrgClaimStatus?
  note           String?
  followUpAt     DateTime?

  correctedCpt   String?
  correctedIcd10 String?
  correctedCarc  String?

  // The last code review, cached against the facts it was drawn from so opening
  // the claim twice does not spend a second model call. Cleared when the hash
  // no longer matches what the claim currently says.
  reviewBody      String?
  reviewFactsHash String?
  reviewedAt      DateTime?

  // The last bounded verdict — the constrained judgment the prose above is a
  // reading of. Same cache contract as reviewBody, one layer earlier, but keyed
  // on a wider hash: the verdict also depends on the balance and on how long is
  // left to file, neither of which reviewFactsHash fingerprints.
  //
  // Json because it is structured and read field by field. A Json column's shape
  // is not enforced by the database, so an older-shaped verdict must parse to
  // "no verdict" rather than throw — see lib/claims/predict.ts.
  predictionBody      Json?
  predictionFactsHash String?
  predictionModel     String?
  predictedAt         DateTime?

  // Stamped explicitly on real work, never @updatedAt — the same rule
  // DenialRow.lastTouchedAt follows, for the same reason.
  lastTouchedAt DateTime?

  events    ClaimEvent[]
  createdAt DateTime     @default(now())

  @@unique([orgId, claimNumber])
  @@index([orgId, followUpAt])
  @@map("claim_work")
}

// One thing that happened to a claim. Append-only.
//
// The product had no per-record history at all: AgentLog is not org-scoped, and
// a denial's past could only be reconstructed from lastTouchedAt plus its
// submissions. "How many times have we chased this" was unanswerable.
model ClaimEvent {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workId String
  work   ClaimWork    @relation(fields: [workId], references: [id], onDelete: Cascade)

  kind    ClaimEventKind
  // Free text for the timeline: "Denied to Paid", "CPT 99213 to 99214".
  detail  String?
  // Plain string, no relation — matching ImportBatch.uploadedById.
  actorId String?

  createdAt DateTime @default(now())

  @@index([orgId, workId, createdAt(sort: Desc)])
  @@map("claim_events")
}

// How one person has set up their worklist, and where they were in it.
//
// Org-scoped as well as user-scoped because everything customer-facing here is,
// and because the same person working two workspaces wants two layouts rather
// than one that follows them between customers.
//
// Every column is nullable and means "not chosen": a workspace that has never
// touched any of this has no row at all, and the client falls back to its own
// defaults rather than to zeroes written by a migration.
model WorklistPreference {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // { "claim": 220, "payer": 180 } — column key to pixel width.
  columnWidths Json?
  // How much width the table keeps when the work panel is open, 0.35-0.75.
  splitRatio   Float?

  // Where this person was when they last closed the page. Plain strings, not a
  // relation: a resume pointer to a row that has since been deleted should read
  // as "nothing to resume", not block the delete or fail a join.
  lastRowId String?
  lastStep  String?

  // When they last said they had seen the queue. Read by the "what changed"
  // digest; stamped on an explicit action, never on render.
  worklistSeenAt DateTime?

  // Keystrokes in the letter editor that were never committed as a version.
  //
  // There is no autosave: a DenialDraft row every two seconds would turn the
  // version list into landfill and destroy the one thing it is for, going back
  // to the draft you preferred. So unsaved text parks here instead, offered
  // back as Restore or Discard, and a version is only ever written on a
  // deliberate Save.
  //
  // scratchRowId is what makes this safe to hand back. One row per person per
  // workspace holds one scratch, and without the row it belongs to, reopening a
  // different claim would offer someone the half-edited letter from another
  // one. It is a plain string for the same reason lastRowId is.
  //
  // scratchBody passes the same patient-placeholder guard as saveDraftBody. It
  // is a letter body with [PATIENT NAME] still in it, like every other body
  // this schema holds.
  scratchRowId       String?
  scratchBody        String?
  scratchBaseVersion Int?
  scratchAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, userId])
  @@map("worklist_preferences")
}

// One thing that happened to a denial row. Append-only.
//
// DenialRow.note is a single column that every save overwrites, so a biller who
// wrote "called Aetna, they want the op note" and later wrote "op note faxed"
// had destroyed the first sentence to write the second. The column stays as the
// current value — draft-response.ts reads it to build the letter — and this is
// where its history lives.
//
// Deliberately not a DenialNote table. The worklist needs a dated history of
// everything that happened to a row, not just of its notes, and two append-only
// tables would mean merging three sources into one timeline instead of one.
// NOTE_ADDED.detail IS the note history.
//
// Same no-PHI rule as the column it shadows: a note records what a payer said on
// the phone, never who the patient is.
model DenialEvent {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rowId String
  row   DenialRow    @relation(fields: [rowId], references: [id], onDelete: Cascade)

  kind    DenialEventKind
  // The note body for NOTE_ADDED; the date, or "cleared", for FOLLOW_UP_SET;
  // "To Work to Drafted" for STATUS_CHANGED.
  detail  String?
  // Plain string, no relation — matching ClaimEvent.actorId and
  // ImportBatch.uploadedById.
  actorId String?

  createdAt DateTime @default(now())

  @@index([orgId, rowId, createdAt(sort: Desc)])
  @@map("denial_events")
}

// One thing somebody did with the product. Append-only, and counted, never read
// back one row at a time.
//
// WHY THIS IS NOT A ClaimEvent. ClaimEvent is the biller's own record of what
// happened to a claim, and a biller reads it before phoning a payer. "Dana
// expanded the code review" is not part of that story, and putting it there
// would bury the three entries that are under forty that are not.
//
// WHY THERE IS NO claimId. The question this answers is a distribution — of a
// hundred opened claims, how many end at the drafter — and a distribution needs
// counts, not a trail. Storing which claim would make every row joinable back to
// a patient's claim number through OrgClaim, turn a counter into a behavioural
// log about named people, and tempt exactly the per-claim read this is not for.
// The orgId is here because everything customer-facing in this schema is
// org-scoped; the userId because "one biller does this, four do not" and "all
// five do this" are different findings.
//
// `detail` is a bounded qualifier from lib/usage/events.ts — a section id, or
// where a jump to the drafter started from. The router rejects anything else, so
// no free text and no identifier can reach this column.
model UsageEvent {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Plain string, no relation — matching ClaimEvent.actorId. A deleted user
  // should not take the counts they contributed to with them.
  userId String?

  name   UsageEventName
  detail String?

  createdAt DateTime @default(now())

  @@index([orgId, name, createdAt(sort: Desc)])
  @@map("usage_events")
}

// A request for a direct data connection. Database and EHR connectors are a
// custom-plan feature; this records who asked for what so the ask is a recorded
// lead rather than a dead upgrade wall.
model ConnectionRequest {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requestedById String?
  system        String
  notes         String?
  createdAt     DateTime     @default(now())

  @@index([orgId, createdAt(sort: Desc)])
  @@map("connection_requests")
}

// ─── Agent conversations ─────────────────────────────────────────────────────
//
// The chat with the billing assistant, kept so it survives a refresh and so the
// rail can show a history list. Org-scoped like every other customer table and
// additionally filtered by userId: a conversation is one biller's, not the
// workspace's, even though every answer in it was drawn from workspace data.
//
// Nothing here holds a person on the claim. The assistant reads only the three
// tools in lib/ai/workspace-tools.ts, all of which query de-identified tables,
// so the question and the answer can name a claim number, a payer or a CARC
// code and no more. That is the same reason AgentLog can already store `intent`
// and `message`. See __tests__/no-phi-columns.test.ts, which classifies this.

model AgentConversation {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Taken from the opening question, trimmed. Cheap and honest — generating a
  // title costs a model round-trip per conversation to restate what the user
  // just typed.
  title  String

  messages AgentMessage[]

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  @@index([orgId, userId, lastMessageAt(sort: Desc)])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  // The reasoning trace, as TraceStep[] from lib/ai/trace.ts: which tool ran,
  // the arguments it ran with, what came back and which import the rows are
  // from. Stored rather than recomputed because it is the evidence for an
  // answer a biller may act on weeks later, and re-running the tools would
  // produce a different trace against changed data.
  trace          Json?
  agentName      String?
  isError        Boolean           @default(false)
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}
