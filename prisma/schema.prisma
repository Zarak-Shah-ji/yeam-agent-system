// Yeam.ai EHR — Prisma Schema
// HIPAA note: No full SSNs stored; PHI fields are annotated below

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EncounterStatus {
  DRAFT
  SIGNED
  AMENDED
  VOIDED
}

enum ClaimStatus {
  PENDING
  SCRUBBING
  SUBMITTED
  ACCEPTED
  PAID
  DENIED
  APPEALED
  VOIDED
}

enum PlanType {
  HMO
  PPO
  EPO
  POS
  MEDICAID
  MEDICARE
  TRICARE
  SELF_PAY
}

enum AgentName {
  FRONT_DESK
  CLINICAL_DOC
  CLAIM_SCRUBBER
  BILLING
  ANALYTICS
}

enum AgentStatus {
  THINKING
  WORKING
  COMPLETE
  ESCALATED
  ERROR
}

enum UserRole {
  ADMIN
  PROVIDER
  FRONT_DESK
  BILLING
}

enum OrgPlan {
  TRIAGE
  PRACTICE
  GROUP
  NETWORK
}

enum DenialRowStatus {
  TO_WORK
  DRAFTED
  SENT
  PAID
  DEAD
}

// Which profile an upload was read with. A DENIALS batch accumulates work items;
// a CLAIMS batch is a point-in-time snapshot. See lib/imports/claims-profile.ts.
enum ImportKind {
  DENIALS
  CLAIMS
}

enum OrgClaimStatus {
  PAID
  PARTIAL
  DENIED
  PENDING
  REJECTED
  WRITTEN_OFF
  UNKNOWN
}

// ─── NextAuth Tables ─────────────────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole      @default(FRONT_DESK)
  accounts      Account[]
  sessions      Session[]
  agentLogs     AgentLog[]
  // Nullable: the seeded demo accounts pre-date tenancy and have no org. Every
  // account created from here on gets one at signup. Queries that read customer
  // data must go through orgProcedure, which refuses a user without an org
  // rather than falling back to reading everything.
  orgId         String?
  org           Organization? @relation(fields: [orgId], references: [id])
  // The app had no way to answer "who logged in and when" — JWT sessions mean
  // the sessions table is never written. Stamped in the signIn callback.
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([orgId])
  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─── Domain: Payers ──────────────────────────────────────────────────────────

model Payer {
  id                String              @id @default(cuid())
  name              String
  payerId           String              @unique // EDI payer ID
  planType          PlanType
  phone             String?
  address           String?
  claimsAddress     String?
  electronicPayerId String?
  active            Boolean             @default(true)
  coverages         InsuranceCoverage[]
  claims            Claim[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@map("payers")
}

// ─── Domain: Patients ────────────────────────────────────────────────────────

model Patient {
  id                String              @id @default(cuid())
  mrn               String              @unique // Medical Record Number
  // PHI fields below
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  gender            String
  email             String?
  phone             String?
  address           String?
  city              String?
  state             String?
  zip               String?
  ssnLast4          String? // PHI: last 4 digits only
  preferredLanguage String?             @default("en")
  active            Boolean             @default(true)
  coverages         InsuranceCoverage[]
  appointments      Appointment[]
  encounters        Encounter[]
  claims            Claim[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@map("patients")
}

// ─── Domain: Insurance Coverages ─────────────────────────────────────────────

model InsuranceCoverage {
  id              String    @id @default(cuid())
  patientId       String
  payerId         String
  memberId        String // PHI: insurance member ID
  groupNumber     String?
  planName        String?
  effectiveDate   DateTime
  terminationDate DateTime?
  copay           Decimal?  @db.Decimal(8, 2)
  deductible      Decimal?  @db.Decimal(10, 2)
  deductibleMet   Decimal?  @db.Decimal(10, 2)
  outOfPocketMax  Decimal?  @db.Decimal(10, 2)
  outOfPocketMet  Decimal?  @db.Decimal(10, 2)
  isPrimary       Boolean   @default(true)
  active          Boolean   @default(true)
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payer           Payer     @relation(fields: [payerId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("insurance_coverages")
}

// ─── Domain: Providers ───────────────────────────────────────────────────────

model Provider {
  id           String        @id @default(cuid())
  npi          String        @unique // National Provider Identifier
  firstName    String
  lastName     String
  credential   String? // MD, DO, NP, PA, etc.
  specialty    String?
  email        String?
  phone        String?
  active       Boolean       @default(true)
  appointments Appointment[]
  encounters   Encounter[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("providers")
}

// ─── Domain: Appointments ────────────────────────────────────────────────────

model Appointment {
  id                 String            @id @default(cuid())
  patientId          String
  providerId         String
  scheduledAt        DateTime
  duration           Int               @default(30) // minutes
  status             AppointmentStatus @default(SCHEDULED)
  appointmentType    String? // new-patient, follow-up, annual-wellness, etc.
  chiefComplaint     String?
  notes              String?
  cancelledAt        DateTime?
  cancellationReason String?
  cancelledBy        String? // stores user.id
  encounter          Encounter?
  patient            Patient           @relation(fields: [patientId], references: [id])
  provider           Provider          @relation(fields: [providerId], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@map("appointments")
}

// ─── Domain: Encounters ──────────────────────────────────────────────────────

model Encounter {
  id            String          @id @default(cuid())
  appointmentId String?         @unique
  patientId     String
  providerId    String
  encounterDate DateTime
  status        EncounterStatus @default(DRAFT)
  // PHI: clinical documentation
  subjective    String?
  objective     String?
  assessment    String?
  plan          String?
  signedAt      DateTime?
  signedBy      String?
  diagnoses     Diagnosis[]
  procedures    Procedure[]
  claims        Claim[]
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id])
  patient       Patient         @relation(fields: [patientId], references: [id])
  provider      Provider        @relation(fields: [providerId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("encounters")
}

// ─── Domain: Diagnoses ───────────────────────────────────────────────────────

model Diagnosis {
  id          String    @id @default(cuid())
  encounterId String
  icdCode     String // ICD-10-CM code
  description String
  isPrimary   Boolean   @default(false)
  sequence    Int       @default(1)
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@map("diagnoses")
}

// ─── Domain: Procedures ──────────────────────────────────────────────────────

model Procedure {
  id          String    @id @default(cuid())
  encounterId String
  cptCode     String // CPT/HCPCS code
  description String
  units       Int       @default(1)
  fee         Decimal   @db.Decimal(10, 2)
  modifier    String?
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@map("procedures")
}

// ─── Domain: Claims ──────────────────────────────────────────────────────────

model Claim {
  id             String       @id @default(cuid())
  claimNumber    String       @unique
  patientId      String
  payerId        String
  encounterId    String?
  status         ClaimStatus  @default(PENDING)
  totalCharge    Decimal      @db.Decimal(10, 2)
  allowedAmount  Decimal?     @db.Decimal(10, 2)
  paidAmount     Decimal?     @db.Decimal(10, 2)
  patientBalance Decimal?     @db.Decimal(10, 2)
  serviceDate    DateTime
  submittedAt    DateTime?
  adjudicatedAt  DateTime?
  denialReason   String?
  notes          String?
  events         ClaimEvent[]
  patient        Patient      @relation(fields: [patientId], references: [id])
  payer          Payer        @relation(fields: [payerId], references: [id])
  encounter      Encounter?   @relation(fields: [encounterId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("claims")
}

// ─── Domain: Claim Events ────────────────────────────────────────────────────

model ClaimEvent {
  id        String      @id @default(cuid())
  claimId   String
  status    ClaimStatus
  notes     String?
  agentName AgentName?
  automated Boolean     @default(false)
  claim     Claim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@map("claim_events")
}

// ─── Medicaid Dataset Tables ─────────────────────────────────────────────────

model MedicaidProvider {
  npi                         String              @id // NPI — unique provider identifier
  orgName                     String? // billing_name / servicing_name
  firstName                   String?
  middleName                  String?
  lastName                    String?
  credentials                 String? // MD, DO, NP, etc.
  orgNameOther                String?
  addrLine1                   String?
  addrLine2                   String?
  city                        String?
  state                       String?
  zip                         String?
  phone                       String?
  billedClaims                MedicaidClaimsAgg[] @relation("BillingProvider")
  servicedClaims              MedicaidClaimsAgg[] @relation("ServicingProvider")
  medicaidPatients            MedicaidPatient[]
  medicaidEncountersBilling   MedicaidEncounter[] @relation("BillingEncounterProvider")
  medicaidEncountersServicing MedicaidEncounter[] @relation("ServicingEncounterProvider")
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  @@map("medicaid_providers")
}

model MedicaidClaimsAgg {
  id                String            @id @default(cuid())
  billingNpi        String
  servicingNpi      String?
  procCode          String // HCPCS code (proc_cd column)
  yearMonth         String // e.g. "2018-01" (month column)
  numBeneficiaries  Int?
  numClaims         Int?
  paidAmount        Decimal?          @db.Decimal(12, 2)
  aoFirstName       String?
  aoMiddleName      String?
  aoLastName        String?
  billingProvider   MedicaidProvider  @relation("BillingProvider", fields: [billingNpi], references: [npi])
  servicingProvider MedicaidProvider? @relation("ServicingProvider", fields: [servicingNpi], references: [npi])
  createdAt         DateTime          @default(now())

  @@index([billingNpi])
  @@index([servicingNpi])
  @@index([procCode])
  @@index([yearMonth])
  @@index([billingNpi, procCode, yearMonth])
  @@map("medicaid_claims_agg")
}

model MedicaidPatient {
  id                 String              @id @default(cuid())
  mrn                String              @unique // e.g. "MRN-TX-000001"
  firstName          String
  lastName           String
  dateOfBirth        DateTime
  gender             String?
  phone              String?
  email              String?
  addrLine1          String?
  city               String?
  state              String?             @default("TX")
  zip                String?
  insuranceType      String?             @default("Medicaid")
  insuranceId        String?
  // Key into the payer directory in lib/billing/payers.ts. Drives the address
  // block, appeal window and house style used when drafting an appeal letter.
  payerKey           String?
  insuranceStatus    String?             @default("active")
  primaryProviderNpi String?
  primaryProvider    MedicaidProvider?   @relation(fields: [primaryProviderNpi], references: [npi])
  encounters         MedicaidEncounter[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([primaryProviderNpi])
  @@map("medicaid_patients")
}

model MedicaidEncounter {
  id              String            @id @default(cuid())
  patientId       String
  providerNpi     String
  billingNpi      String?
  encounterDate   DateTime
  procCode        String
  diagnosisCodes  String[]
  status          String?           @default("completed")
  claimStatus     String?           @default("clean")
  paidAmount      Decimal?          @db.Decimal(12, 2)
  // Submitted charge. Distinct from paidAmount, which is 0 on a denied claim —
  // an appeal letter has to state the amount actually in dispute.
  billedAmount    Decimal?          @db.Decimal(12, 2)
  // Date the remittance advice / R&S report was issued. The appeal filing
  // window runs from this date, not from the date of service.
  remittanceDate  DateTime?
  denialReason    String?
  denialCode      String? // CARC/RARC, e.g. "CO-50"
  notes           String?
  patient         MedicaidPatient   @relation(fields: [patientId], references: [id])
  provider        MedicaidProvider  @relation("ServicingEncounterProvider", fields: [providerNpi], references: [npi])
  billingProvider MedicaidProvider? @relation("BillingEncounterProvider", fields: [billingNpi], references: [npi])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([patientId])
  @@index([providerNpi])
  @@index([claimStatus])
  @@index([encounterDate])
  @@map("medicaid_encounters")
}

model HcpcsCode {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  category    String?
  avgCostTx   Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@map("hcpcs_codes")
}

// ─── Domain: Agent Logs ──────────────────────────────────────────────────────

model AgentLog {
  id         String      @id @default(cuid())
  taskId     String
  agentName  AgentName
  status     AgentStatus
  intent     String
  message    String
  reasoning  String?
  confidence Float?
  data       Json?
  userId     String?
  sessionId  String?
  durationMs Int?
  user       User?       @relation(fields: [userId], references: [id])
  createdAt  DateTime    @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@map("agent_logs")
}

// ─── Denial Workspace ────────────────────────────────────────────────────────
//
// The paid product: a billing company's own denials, saved, with the filing
// deadline still ticking tomorrow. Separate from the Patient/Encounter/Claim
// tables above, which are a synthetic single-tenant demo and are NOT org-scoped.
// Nothing here may reference those.
//
// De-identification is a schema-level promise, not just copy: there is no column
// for a patient name, member ID or date of birth, so a parser bug cannot quietly
// persist one. See lib/imports/deidentify.ts for the veto every import profile
// applies, and the FieldId unions in lib/denials/parse-claims.ts and
// lib/imports/claims-profile.ts for the only fields that are ever read.

model Organization {
  id                 String              @id @default(cuid())
  name               String
  plan               OrgPlan             @default(TRIAGE)
  users              User[]
  batches            ImportBatch[]
  rows               DenialRow[]
  claims             OrgClaim[]
  drafts             DenialDraft[]
  workedEvents       DenialWorkedEvent[]
  connectionRequests ConnectionRequest[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("organizations")
}

// One upload. Holds either denial rows or claim rows depending on `kind`, which
// is why this is no longer called DenialBatch: the import summary, the refused
// column list and the delete-this-batch path are identical for both profiles.
model ImportBatch {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind           ImportKind   @default(DENIALS)
  // A sample-practice batch, seeded with the workspace so a new account has
  // something to look at. Dropped the moment a real file lands, because seeded
  // rows sitting in the totals next to a customer's own denials is worse than
  // an empty worklist.
  isSample       Boolean      @default(false)
  filename       String
  rowCount       Int
  // Columns refused at parse time, surfaced in the import summary so the
  // customer can see that the patient names never left their machine.
  droppedColumns String[]
  // True when the export had no status column and status was inferred from the
  // amounts. Surfaced so a derived denial rate is never passed off as a read one.
  statusDerived  Boolean      @default(false)
  uploadedById   String?
  rows           DenialRow[]
  claims         OrgClaim[]
  createdAt      DateTime     @default(now())

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, kind, createdAt(sort: Desc)])
  @@map("import_batches")
}

model DenialRow {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  batchId String
  batch   ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // Facts as they arrived. De-identified by construction.
  claimNumber String?
  payer       String?
  carc        String
  billed      Decimal   @db.Decimal(12, 2)
  // Remittance date where the export had one, service date as the fallback.
  denialDate  DateTime?
  cpt         String?
  icd10       String?
  reason      String?

  // Human-owned state. Everything else about a row — remedy, filing window,
  // days left, whether it is expired — is DERIVED on read by triageRow() and is
  // deliberately not stored. A persisted deadline is wrong the next morning, and
  // a persisted remedy goes stale the moment the CARC rules are corrected.
  status DenialRowStatus @default(TO_WORK)
  note   String?

  // When a human last did something to this row — marked it sent, recorded an
  // outcome, left a note. Deliberately NOT updatedAt: any batch write resets
  // that, which would report a row as freshly handled when nothing happened to
  // it. The priority score reads this as the "last touch" signal, so a write
  // here must correspond to real work. See lib/denials/score.ts.
  lastTouchedAt DateTime?

  // A date the biller set themselves, usually when marking a row sent. Their
  // judgement about when to look again outranks anything derived, so an overdue
  // follow-up lifts the row in the queue.
  followUpAt DateTime?

  drafts      DenialDraft[]
  workedEvent DenialWorkedEvent?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([orgId, status])
  @@index([batchId])
  // Overdue follow-ups are read across the whole workspace, not per batch.
  @@index([orgId, followUpAt])
  @@map("denial_rows")
}

model DenialDraft {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rowId String
  row   DenialRow    @relation(fields: [rowId], references: [id], onDelete: Cascade)

  // Which instrument the denial actually calls for — appeal letter, corrected
  // claim, reconsideration, reprocessing request. Chosen by artifactFor().
  artifact  String
  body      String
  summary   String?
  // Revisions append rather than overwrite, so a customer can go back to the
  // draft they preferred after asking for it shorter.
  version   Int      @default(1)
  createdAt DateTime @default(now())

  @@index([orgId, createdAt(sort: Desc)])
  @@index([rowId, version])
  @@map("denial_drafts")
}

model DenialWorkedEvent {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Unique: a denial is billable once, no matter how many times it is redrafted.
  // Enforced here rather than in application code so a retry cannot double-bill.
  rowId String       @unique
  row   DenialRow    @relation(fields: [rowId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@map("denial_worked_events")
}

// A claim line from an A/R export. The denominator the denial worklist lacks.
//
// Same discipline as DenialRow: facts as they arrived, nothing derived stored.
// Aging buckets, collection rate and denial rate are all computed on read from
// these columns plus today's date, because a bucket written to the database is
// wrong the next morning.
//
// No patient identifier column exists here, deliberately. A claims export almost
// always carries a patient name; lib/imports/deidentify.ts refuses it at parse
// time and this schema gives it nowhere to land if that ever fails.
model OrgClaim {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  batchId String
  batch   ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  claimNumber String?
  payer       String?
  status      OrgClaimStatus @default(UNKNOWN)

  billed      Decimal  @db.Decimal(12, 2)
  allowed     Decimal? @db.Decimal(12, 2)
  paid        Decimal? @db.Decimal(12, 2)
  patientResp Decimal? @db.Decimal(12, 2)
  adjustment  Decimal? @db.Decimal(12, 2)

  serviceDate   DateTime?
  submittedDate DateTime?
  remitDate     DateTime?

  cpt   String?
  icd10 String?
  carc  String?

  createdAt DateTime @default(now())

  @@index([orgId, status])
  @@index([batchId])
  @@index([orgId, serviceDate])
  // Joins a denied claim back to the worklist row that is working it.
  @@index([orgId, claimNumber])
  @@map("org_claims")
}

// A request for a direct data connection. Database and EHR connectors are a
// custom-plan feature; this records who asked for what so the ask is a recorded
// lead rather than a dead upgrade wall.
model ConnectionRequest {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requestedById String?
  system        String
  notes         String?
  createdAt     DateTime     @default(now())

  @@index([orgId, createdAt(sort: Desc)])
  @@map("connection_requests")
}
